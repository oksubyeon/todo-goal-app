# MongoDB 연결 문자열. 로컬에 MongoDB가 없으면 `npm run db`로 메모리 DB를 띄우고 아래 값을 그대로 쓰세요.
MONGODB_URI=mongodb://127.0.0.1:27018/todo-goal-app

# GitHub OAuth App (만드는 방법: docs/GITHUB_OAUTH.md)
# 비밀값은 이 파일이 아니라 .env에만 넣으세요. .env는 git에 올라가지 않습니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# (선택) 배포 주소. 비워 두면 요청이 들어온 주소를 기준으로 콜백 URL을 만듭니다.
# 예: APP_URL=https://todo.example.com  →  콜백: https://todo.example.com/auth/github/callback
APP_URL=
